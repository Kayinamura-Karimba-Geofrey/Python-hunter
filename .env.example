# Python Hunter Environment Configuration Template

# General Environment
PYH_ENV=development
PYH_DEBUG=true
PYH_LOG_LEVEL=INFO

# REST API Configuration
PYH_API_HOST=0.0.0.0
PYH_API_PORT=8000
PYH_SECRET_KEY=change-this-in-production-super-secret-key-32-chars

# PostgreSQL Database Configuration
PYH_POSTGRES_USER=python_hunter
PYH_POSTGRES_PASSWORD=python_hunter_pass
PYH_POSTGRES_HOST=localhost
PYH_POSTGRES_PORT=5432
PYH_POSTGRES_DB=python_hunter_db

# Redis Broker Configuration
PYH_REDIS_HOST=localhost
PYH_REDIS_PORT=6379
PYH_REDIS_DB=0

# Scan & Security Limits
PYH_MAX_SCAN_FILE_SIZE_MB=10
PYH_SCAN_TIMEOUT_SECONDS=300
PYH_MAX_ARCHIVE_RATIO=10
