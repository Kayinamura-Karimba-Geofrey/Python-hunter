# Python Hunter Environment Configuration Template

# General Environment
PYH_ENV=development
PYH_DEBUG=true
PYH_LOG_LEVEL=INFO

# REST API Configuration
PYH_API_HOST=127.0.0.1
PYH_API_PORT=8000
# REQUIRED in production. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Startup is refused if this is empty or left at the old default outside development.
PYH_SECRET_KEY=

# API login. Login is disabled (HTTP 503) until both are set. Generate the hash with:
# python -c "from getpass import getpass; from python_hunter.application.api.security import hash_password; print(hash_password(getpass()))"
PYH_API_USERNAME=
PYH_API_PASSWORD_HASH=
PYH_API_TOKEN_TTL_MINUTES=60
# Comma-separated browser origins allowed to call the API (wildcard is rejected)
PYH_API_CORS_ORIGINS=http://localhost:5173
# API scan targets must resolve inside this directory (defaults to the server's working directory)
PYH_API_WORKSPACE_ROOT=
PYH_API_ALLOW_REMOTE_TARGETS=false
PYH_API_MAX_CONCURRENT_SCANS=2

# Scan records, PR analyses, and the audit log (default: ~/.python-hunter)
PYH_DATA_DIR=

# GitHub webhook HMAC secret (X-Hub-Signature-256 verification).
# REQUIRED for webhook processing; there is no built-in default.
PYH_WEBHOOK_SECRET=

# Scan & Security Limits
PYH_MAX_SCAN_FILE_SIZE_MB=10
PYH_SCAN_TIMEOUT_SECONDS=300
PYH_MAX_ARCHIVE_RATIO=10
